# ----------------------------------------------------------------------------
# Frontend (React / Vite) - apps/frontend
# ----------------------------------------------------------------------------
# dependencies
apps/frontend/node_modules/
apps/frontend/.pnp
apps/frontend/.pnp.js

# build & testing
apps/frontend/dist/
apps/frontend/build/
apps/frontend/coverage/

# env files (NEVER COMMIT THESE)
apps/frontend/.env
apps/frontend/.env.local
apps/frontend/.env.development.local
apps/frontend/.env.test.local
apps/frontend/.env.production.local

# misc
apps/frontend/npm-debug.log*
apps/frontend/yarn-debug.log*
apps/frontend/yarn-error.log*
apps/frontend/pnpm-debug.log*

# ----------------------------------------------------------------------------
# Backend (Spring Boot / Maven or Gradle) - apps/backend
# ----------------------------------------------------------------------------
# Maven
apps/backend/target/
apps/backend/pom.xml.tag
apps/backend/pom.xml.releaseBackup
apps/backend/pom.xml.versionsBackup
apps/backend/pom.xml.next
apps/backend/release.properties
apps/backend/dependency-reduced-pom.xml
apps/backend/buildNumber.properties
apps/backend/.mvn/timing.properties
apps/backend/.mvn/wrapper/maven-wrapper.jar

# Gradle
apps/backend/.gradle/
apps/backend/build/

# IDE specific (Eclipse, IntelliJ)
apps/backend/.settings/
apps/backend/.metadata/
apps/backend/bin/
apps/backend/.classpath
apps/backend/.project
apps/backend/*.iml

# Log Files
apps/backend/logs/
apps/backend/*.log
apps/backend/hotspot.compiler
apps/backend/hs_err_pid*

# Spring Boot
apps/backend/HELP.md

# env files (NEVER COMMIT THESE)
apps/backend/.env
apps/backend/application-secret.properties
apps/backend/application-secret.yml

# ----------------------------------------------------------------------------
# Infra (Docker etc.)
# ----------------------------------------------------------------------------
# Don't commit hardcoded TLS certs/keys or sensitive docker-compose values
infra/**/*.key
infra/**/*.crt
infra/**/*.pem
infra/.env

# ----------------------------------------------------------------------------
# System / Local Tools
# ----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.log
node_modules
